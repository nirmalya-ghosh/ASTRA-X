# ══════════════════════════════════════════════════════════════
# AstraX AI — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
ASTRAX_APP_NAME=AstraX AI
ASTRAX_APP_VERSION=0.1.0
ASTRAX_DEBUG=true
ASTRAX_LOG_LEVEL=INFO
ASTRAX_SECRET_KEY=change-this-to-a-random-secret-key

# ── Server ────────────────────────────────────────────────────
ASTRAX_HOST=0.0.0.0
ASTRAX_PORT=8000
ASTRAX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Database ──────────────────────────────────────────────────
ASTRAX_DATABASE_URL=sqlite+aiosqlite:///./astrax.db

# ── Storage ───────────────────────────────────────────────────
ASTRAX_DATA_DIR=./data
ASTRAX_UPLOAD_DIR=./data/uploads
ASTRAX_CACHE_DIR=./data/cache
ASTRAX_EXPORT_DIR=./data/exports

# ── Processing ────────────────────────────────────────────────
ASTRAX_MAX_WORKERS=4
ASTRAX_GPU_ENABLED=false

# ── Detection Defaults ───────────────────────────────────────
ASTRAX_DETECTION_FWHM=3.0
ASTRAX_DETECTION_THRESHOLD_SIGMA=5.0
ASTRAX_MOTION_THRESHOLD=2.0
ASTRAX_CONFIDENCE_THRESHOLD=0.5
ASTRAX_NOISE_SIGMA_CLIP=3.0

# ── Task Queue (optional — leave empty for in-process mode) ──
# ASTRAX_CELERY_BROKER_URL=redis://localhost:6379/0
# ASTRAX_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── AI Assistant (optional) ──────────────────────────────────
# Supported providers: gemini, openai, anthropic, openrouter
# ASTRAX_LLM_PROVIDER=gemini
# ASTRAX_LLM_MODEL=gemini-2.0-flash
# ASTRAX_LLM_API_KEY=your-api-key-here
# ASTRAX_LLM_BASE_URL=

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
